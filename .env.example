# Copy to .env and fill in. .env is git-ignored; never commit a token.
# Precedence: command line > real environment variables > .env file.

# Required
JIRA_URL=https://jira.example.local
JIRA_TOKEN=
JIRA_PROJECTS=PROJ OPS

# Optional
# JIRA_OUT=jira-archive
# JIRA_JQL=updated >= -7d
# JIRA_CA_BUNDLE=ca.pem
# JIRA_INSECURE=false
# JIRA_FORCE=false
# JIRA_DEV_STATUS=false
# JIRA_FETCH_EXTERNAL_IMAGES=false
# JIRA_WORKERS=4          # tickets archived in parallel; 1 = sequential
# JIRA_ENV_FILE=          # only useful as a real env var: alternative .env location
